<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../Managed/ILVM.Runtime/ILVM.Runtime.csproj" />
    <ProjectReference Include="../Samples/Hotfix/Hotfix.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyHotfix" AfterTargets="Build">
    <Copy SourceFiles="../Samples/Hotfix/bin/$(Configuration)/net8.0/Game.Hotfix.dll" DestinationFolder="$(OutDir)Hotfix" />
  </Target>
</Project>
